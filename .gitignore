# --- OS-generated files ---
.DS_Store
Thumbs.db
*.swp
*.swo
*.bak
*.orig

# --- Editors / IDEs ---
.idea/
*.iml
.vscode/
/nbproject/private/
# PhpStorm/IDEA project XML lives in .idea/ above.
# Avoid blanket *.xml; ignore specific config files individually below.

# --- Local dev environments ---
/.ddev/
/.htaccess

# --- AI agent tooling ---
# Dirs themselves are tracked (workflow lives in the repo); only machine-local
# files are ignored. The Composer-published tarball still excludes everything
# via .gitattributes export-ignore.
/.claude/settings.local.json

# --- Composer / PHP dependencies ---
/vendor/
/composer.lock

# --- PHP tooling caches and configs ---
/.phpunit.result.cache
/.phpunit.cache/
/.php-cs-fixer.cache
/.phpstan-cache/
/.psalm/
/phpcs.xml
/phpcs.xml.dist
/phpunit.xml
/phpunit.xml.dist

# --- Build / coverage artifacts ---
/build/
/coverage/

# --- Node (if used for asset pipelines) ---
/node_modules/

# --- Logs and scratch directories ---
*.log
*.cache
*.tmp
/tmp/
/temp/
/logs/
# Keep the logs/ directory in the tree as a placeholder.
!/logs/.gitkeep

# --- Secrets / per-environment config ---
.env
.env.*
# (Files like .env.testing, .env.production, .env.local are all covered above.)
/includes/config.php
/admin/config.php

# --- Internal planning / docs ---
# docs/ is tracked (PRD, roadmap, iteration specs); .gitattributes export-ignore
# keeps it out of the Composer-published tarball.
